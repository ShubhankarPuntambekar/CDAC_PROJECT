    sprintf(msg,
            "Raw=%4u  Filter=%4u  Rel=%4d  PWM=%2u  Mode=%s\r\n",
            rawDistance,
            distance,
            RelativeSpeed_Get(),
            Decision_GetPWM(),
            Decision_GetModeString());

    HAL_UART_Transmit(&huart5,
                      (uint8_t *)msg,
                      strlen(msg),
                      HAL_MAX_DELAY);
}
