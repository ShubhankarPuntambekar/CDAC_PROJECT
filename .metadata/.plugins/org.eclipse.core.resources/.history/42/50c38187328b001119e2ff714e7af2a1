void CAN_TRANSMITT(void)
{
#ifdef BOARD1
  lidarRead();
  TxData[0] = (uint8_t)(sensor_data >> 8);   // High byte
  TxData[1] = (uint8_t)(sensor_data & 0xFF); // Low byte
#endif

#ifdef BOARD1

  HAL_CAN_AddTxMessage(&hcan1,
                       &TxHeader,
                       TxData,
                       &TxMailbox);

  HAL_UART_Transmit(&huart5,
                    (uint8_t *)"CAN Message Sent\r\n",
                    18,
                    HAL_MAX_DELAY);

  HAL_Delay(500);

#endif


#ifdef BOARD2

  /* Receiver does nothing here.
     Reception happens in interrupt. */

  HAL_Delay(10);

#endif
}


void CAN_Headers(void)
{
	  TxHeader.StdId = 0x123;
	  TxHeader.ExtId = 0x00;
	  TxHeader.IDE = CAN_ID_STD;
	  TxHeader.RTR = CAN_RTR_DATA;
	  TxHeader.DLC = 5;
	  TxHeader.TransmitGlobalTime = DISABLE;
}

#ifdef BOARD2

void HAL_CAN_RxFifo0MsgPendingCallback(CAN_HandleTypeDef *hcan)
{
    HAL_CAN_GetRxMessage(hcan,
                         CAN_RX_FIFO0,
                         &RxHeader,
                         RxData);

    char msg[80];

    uint16_t rawDistance;

    /* Read raw distance from CAN */
    rawDistance = ((uint16_t)RxData[0] << 8) | RxData[1];

    /* Apply EMA Filter */
    distance = Sensor_Filter(rawDistance);

    /* Calculate relative speed using FILTERED distance */
    RelativeSpeed_Update(distance);

    /* Decision Logic */
    Decision_Update(distance);

    /* Set target PWM */
    Ramp_SetTarget(Decision_GetPWM());
//
