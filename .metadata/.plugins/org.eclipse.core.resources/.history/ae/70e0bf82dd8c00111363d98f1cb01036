#include "OLED_DISPLAY.h"

#include <stdio.h>

#include "ssd1306.h"
#include "ssd1306_fonts.h"

#include "SENSOR_TOF.h"
#include "RAMP_CONTROL.h"



static char line1[20];
//static char line2[20];

void OLED_Init(void)
{
    ssd1306_Init();

    ssd1306_Fill(Black);

    ssd1306_UpdateScreen();
}

void OLED_Update(void)
{
    char line[25];

    ssd1306_Fill(Black);

    /* Distance */
    sprintf(line, "Dist : %4d mm", sensor_data);
    ssd1306_SetCursor(0, 0);
    ssd1306_WriteString(line, Font_7x10, White);

    /* Mode */
    sprintf(line, "Mode : %-7s", Decision_GetModeString());
    ssd1306_SetCursor(0, 16);
    ssd1306_WriteString(line, Font_7x10, White);

    /* PWM */
    sprintf(line, "PWM  : %3d %%", Ramp_GetCurrentPWM());
    ssd1306_SetCursor(0, 32);
    ssd1306_WriteString(line, Font_7x10, White);

    /* CAN Status */
    sprintf(line, "CAN  : %-7s", "OK");
    ssd1306_SetCursor(0, 48);
    ssd1306_WriteString(line, Font_7x10, White);

    ssd1306_UpdateScreen();
}
