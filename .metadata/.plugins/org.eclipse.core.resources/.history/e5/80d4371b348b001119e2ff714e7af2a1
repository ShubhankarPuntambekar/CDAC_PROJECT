#include"CAN_COMM.h"

CAN_TxHeaderTypeDef TxHeader;
CAN_RxHeaderTypeDef RxHeader;

uint8_t TxData[8];
uint8_t RxData[8];

uint32_t TxMailbox;

uint16_t distance;

void CAN_UART(void)
{


HAL_UART_Transmit(&huart5,
                  (uint8_t *)"BOARD2 Ready\r\n",
                  14,
                  HAL_MAX_DELAY);


}




void CAN_Headers(void)
{
	  TxHeader.StdId = 0x123;
	  TxHeader.ExtId = 0x00;
	  TxHeader.IDE = CAN_ID_STD;
	  TxHeader.RTR = CAN_RTR_DATA;
	  TxHeader.DLC = 5;
	  TxHeader.TransmitGlobalTime = DISABLE;
}



void HAL_CAN_RxFifo0MsgPendingCallback(CAN_HandleTypeDef *hcan)
{
    HAL_CAN_GetRxMessage(hcan,
                         CAN_RX_FIFO0,
                         &RxHeader,
                         RxData);

    char msg[80];

    uint16_t rawDistance;

    /* Read raw distance from CAN */
    rawDistance = ((uint16_t)RxData[0] << 8) | RxData[1];

    /* Apply EMA Filter */
    distance = Sensor_Filter(rawDistance);

    /* Calculate relative speed using FILTERED distance */
    RelativeSpeed_Update(distance);

    /* Decision Logic */
    Decision_Update(distance);

    /* Set target PWM */
    Ramp_SetTarget(Decision_GetPWM());
//
//    float error;
//    float pwm;
//    uint16_t DesiredDistance = 1000;
//    error = distance - DesiredDistance;
//
//    pwm = PID_Update(error);
//
//    Ramp_SetTarget((uint8_t)pwm);

    sprintf(msg,
            "Raw=%4u  Filter=%4u  Rel=%4d  PWM=%2u  Mode=%s\r\n",
            rawDistance,
            distance,
            RelativeSpeed_Get(),
            Decision_GetPWM(),
            Decision_GetModeString());

    HAL_UART_Transmit(&huart5,
                      (uint8_t *)msg,
                      strlen(msg),
                      HAL_MAX_DELAY);
}




void CAN_Init(void)
{

CAN_FilterTypeDef filter;

filter.FilterBank = 0;
filter.FilterMode = CAN_FILTERMODE_IDMASK;
filter.FilterScale = CAN_FILTERSCALE_32BIT;

filter.FilterIdHigh = 0;
filter.FilterIdLow = 0;

filter.FilterMaskIdHigh = 0;
filter.FilterMaskIdLow = 0;

filter.FilterFIFOAssignment = CAN_FILTER_FIFO0;
filter.FilterActivation = ENABLE;
filter.SlaveStartFilterBank = 14;

HAL_CAN_ConfigFilter(&hcan1,&filter);

HAL_CAN_Start(&hcan1);

HAL_CAN_ActivateNotification(&hcan1,
                             CAN_IT_RX_FIFO0_MSG_PENDING);
HAL_UART_Transmit(&huart5,
                (uint8_t *)"BOARD2 Ready\r\n",
                14,
                HAL_MAX_DELAY);
}
