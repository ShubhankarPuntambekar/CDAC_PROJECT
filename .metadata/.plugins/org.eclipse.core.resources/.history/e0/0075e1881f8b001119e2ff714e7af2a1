#include "PID.h"

#ifdef BOARD2
#define KP  0.05f
#define KI  0.002f
#define KD  0.01f

#define MAX_PWM        70.0f
#define MIN_PWM         0.0f

#define INTEGRAL_MAX 1000.0f
#define INTEGRAL_MIN -1000.0f

static float integral = 0.0f;
static float previousError = 0.0f;

void PID_Init(void)
{
    integral = 0.0f;
    previousError = 0.0f;
}

void PID_Reset(void)
{
    integral = 0.0f;
    previousError = 0.0f;
}

float PID_Update(float error)
{
    float P, I, D;
    float output;

    /* ---------- Proportional ---------- */
    P = KP * error;

    /* ---------- Integral ---------- */
    integral += error;

    if(integral > INTEGRAL_MAX)
        integral = INTEGRAL_MAX;

    if(integral < INTEGRAL_MIN)
        integral = INTEGRAL_MIN;

    I = KI * integral;

    /* ---------- Derivative ---------- */
    D = KD * (error - previousError);

    previousError = error;

    /* ---------- PID Output ---------- */
    output = P + I + D;

    /* ---------- Limit PWM ---------- */
    if(output > MAX_PWM)
        output = MAX_PWM;

    if(output < MIN_PWM)
        output = MIN_PWM;

    return output;
}
#endif
