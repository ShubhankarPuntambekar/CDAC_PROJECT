#include"CAN_COMM.h"

CAN_TxHeaderTypeDef TxHeader;
CAN_RxHeaderTypeDef RxHeader;

uint8_t TxData[8];
uint8_t RxData[8];

uint32_t TxMailbox;

uint16_t distance;

void CAN_UART(void)
{

HAL_UART_Transmit(&huart5,
                  (uint8_t *)"BOARD1 Ready\r\n",
                  14,
                  HAL_MAX_DELAY);

}

void CAN_TRANSMITT(void)
{

  lidarRead();
  TxData[0] = (uint8_t)(sensor_data >> 8);   // High byte
  TxData[1] = (uint8_t)(sensor_data & 0xFF); // Low byte



  HAL_CAN_AddTxMessage(&hcan1,
                       &TxHeader,
                       TxData,
                       &TxMailbox);

  HAL_UART_Transmit(&huart5,
                    (uint8_t *)"CAN Message Sent\r\n",
                    18,
                    HAL_MAX_DELAY);

  HAL_Delay(500);





}


void CAN_Headers(void)
{
	  TxHeader.StdId = 0x123;
	  TxHeader.ExtId = 0x00;
	  TxHeader.IDE = CAN_ID_STD;
	  TxHeader.RTR = CAN_RTR_DATA;
	  TxHeader.DLC = 5;
	  TxHeader.TransmitGlobalTime = DISABLE;
}



void CAN_Init(void)
{

HAL_CAN_Start(&hcan1);
HAL_UART_Transmit(&huart5,
                (uint8_t *)"BOARD1 Ready\r\n",
                14,
                HAL_MAX_DELAY);
}
