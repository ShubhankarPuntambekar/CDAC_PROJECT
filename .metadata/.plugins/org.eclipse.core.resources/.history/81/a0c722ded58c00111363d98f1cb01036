#include "OLED_DISPLAY.h"

#include <stdio.h>

#include "ssd1306.h"
#include "ssd1306_fonts.h"

#include "SENSOR_TOF.h"
#include "RAMP_CONTROL.h"

extern uint16_t sensor_data;

static char line1[20];
static char line2[20];

void OLED_Init(void)
{
    ssd1306_Init();

    ssd1306_Fill(Black);

    ssd1306_UpdateScreen();
}

void OLED_Update(void)
{
    /* Read latest distance */
    lidarRead();

    sprintf(line1,"Dist:%4d mm",sensor_data);

    sprintf(line2,"Speed:%3d %%",Ramp_GetCurrentPWM());

    ssd1306_Fill(Black);

    ssd1306_SetCursor(0,0);
    ssd1306_WriteString(line1,Font_7x10,White);

    ssd1306_SetCursor(0,20);
    ssd1306_WriteString(line2,Font_7x10,White);

    ssd1306_UpdateScreen();
}
