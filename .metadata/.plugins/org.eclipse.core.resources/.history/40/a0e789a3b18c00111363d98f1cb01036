void Ramp_Init(void)
{
    currentPWM = 0;
    targetPWM = 0;
}

void Ramp_SetTarget(uint8_t pwm)
{
    if(pwm > 100)
    {
        pwm = 100;
    }

    targetPWM = pwm;

}

